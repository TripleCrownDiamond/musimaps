Options -MultiViews

# ---------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------
<IfModule mod_headers.c>
  # Prevent the site from being embedded in an iframe (clickjacking protection).
  Header set X-Frame-Options "SAMEORIGIN"

  # Force browsers to respect the Content-Type header (MIME sniffing protection).
  Header set X-Content-Type-Options "nosniff"

  # Limit referrer information to same-origin only.
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Restrict browser features: allow geolocation for self only.
  Header set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let Apache serve real files and directories directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React Router handles every other URL client-side.
  RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------
# Cache headers
# ---------------------------------------------------------------
<IfModule mod_headers.c>
  # index.html and any HTML: always revalidate with the server so a
  # stale copy (pointing at an old hashed bundle) is never served.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Hashed assets (Vite emits content-hashed filenames): safe to cache
  # for a year, the hash changes whenever the content changes.
  <FilesMatch "\.(js|mjs|css|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|eot|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Favicon (nom stable, changée rarement) : cache court pour éviter de
  # servir une ancienne icône après un redéploiement.
  <FilesMatch "^favicon\.png$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>
